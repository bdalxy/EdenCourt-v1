<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v1.2 P2（T8.5）：设备重启后重排每日打听闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".EdenCourtApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EdenCourt">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.EdenCourt">
            <!-- T6.7：edge-to-edge 下不设 windowSoftInputMode，键盘由 Compose imePadding 处理（adjustResize 会造成双 insets，导致对话区沉底/最新消息不可见） -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v1.2 P2（T8.5）：每日打听窗口闹钟接收器。
             T12.3（S2）：exported=false 收敛——AlarmManager 的 PendingIntent 走同 app 组件投递、
             不依赖 exported；adb 调试仍可用 `am broadcast -n <组件>` 显式定向触达非导出组件。
             改 false 可阻止第三方进程构造隐式广播触发耗取 token 额度 -->
        <receiver
            android:name=".data.consult.DailyConsultAlarmReceiver"
            android:exported="false" />
        <!-- v1.2 P2（T8.5）：设备开机后重排每日打听 -->
        <receiver
            android:name=".data.consult.DailyConsultBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- v1.2b（T11.7）：互动自动驱动窗口闹钟接收器。
             T12.3（S2）：exported=false 收敛，理由同 DailyConsultAlarmReceiver -->
        <receiver
            android:name=".data.interaction.InteractionAutoReceiver"
            android:exported="false" />

    </application>

</manifest>